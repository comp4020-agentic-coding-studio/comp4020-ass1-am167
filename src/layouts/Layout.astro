---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Scroll through Earth's changing surface, from its molten formation to its final encounter with the Sun.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030711" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
