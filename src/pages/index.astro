---
import Layout from "../layouts/Layout.astro";
import { TIMELINE } from "../scripts/timeline";

const firstEra = TIMELINE[0];
---

<Layout title="Earth Through Time">
  <div class="space" aria-hidden="true">
    <canvas class="starfield-canvas" data-starfield></canvas>
  </div>

  <header class="site-header">
    <nav class="site-nav" aria-label="Primary navigation">
      <div class="wordmark">
        <a href="./" aria-label="Earth Through Time, home">
          <span class="planet-mark" aria-hidden="true"></span>
          <span class="wordmark-text">
            <span>Earth</span>
            <span>Through Time</span>
          </span>
        </a>
      </div>

      <div
        class="time-range"
        aria-label="Timeline from 4.54 billion years ago to 8 billion years from now"
      >
        <span>4.54 BYA</span>
        <span class="time-line" aria-hidden="true">
          <span class="time-line-fill"></span>
          <span class="time-line-cursor"></span>
        </span>
        <span>+8 BY</span>
      </div>

      <p class="scroll-cue" data-scroll-cue>
        <span>Scroll to travel</span>
        <span class="scroll-arrow" aria-hidden="true">↓</span>
      </p>
    </nav>
  </header>

  <main id="page-top" aria-label="Earth through time">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-content">
        <p class="hero-kicker">One planet · 12 billion years</p>
        <h1 class="hero-title" id="page-title">
          Earth
          <span>Through Time</span>
        </h1>
        <p class="hero-intro">
          Scroll through the life of our planet—from its violent birth 4.54
          billion years ago to its final encounter with a dying Sun.
        </p>
      </div>
    </section>

    <section class="timeline" data-timeline data-testid="earth-timeline">
      <div class="timeline-frame">
        <div class="timeline-stage">
          <div class="era-copy" data-era-copy aria-atomic="true">
            <article class="era-panel" data-era-panel data-era-layer="from">
              <p class="era-kicker">
                <span data-era-counter>01</span>
                <span aria-hidden="true">/</span>
                <span>{String(TIMELINE.length).padStart(2, "0")}</span>
                <span class="era-kicker-line" aria-hidden="true"></span>
                <span data-era-period>{firstEra.period}</span>
              </p>
              <p class="era-date" data-era-date>{firstEra.date}</p>
              <h2 class="era-title" data-era-title>
                {firstEra.title}
              </h2>
              <p class="era-description" data-era-description>
                {firstEra.description}
              </p>
              <aside class="present-reflection" data-present-reflection hidden>
                <p class="reflection-kicker">You are here</p>
                <p class="reflection-scale">
                  If Earth’s life to today were one day, all of written history
                  would arrive in its final tenth of a second.
                </p>
                <p class="reflection-copy">
                  We are not the centre of this story—only a vanishingly brief
                  moment in which the planet became able to remember, reflect,
                  and choose what comes next.
                </p>
                <div class="reflection-pause" aria-hidden="true">
                  <span>Hold this moment</span>
                  <span class="reflection-track">
                    <span class="reflection-fill"></span>
                  </span>
                  <span>Continue</span>
                </div>
              </aside>
            </article>
            <p class="journey-note">
              <span aria-hidden="true">↕</span>
              Scroll in either direction to move through time
            </p>
          </div>

          <figure class="earth-figure" aria-labelledby="earth-caption">
            <div class="red-giant" aria-hidden="true"></div>
            <div class="orbit orbit-outer" aria-hidden="true"></div>
            <div class="orbit orbit-inner" aria-hidden="true"></div>
            <div class="earth-wrap">
              <div class="moon" aria-hidden="true"></div>
              <div
                class="earth-fallback"
                data-earth-fallback
                role="img"
                aria-describedby="globe-description"
              ></div>
              <canvas
                class="earth-canvas"
                data-earth-canvas
                role="img"
                aria-describedby="globe-description"
              ></canvas>
            </div>
            <figcaption class="earth-caption" id="earth-caption">
              <span>Earth</span>
              <span class="caption-rule" aria-hidden="true"></span>
              <span class="short-date-stack" data-short-date-stack>
                <span data-short-date data-era-layer="from">{firstEra.shortDate}</span>
              </span>
              <span class="visually-hidden" id="globe-description" data-globe-label>
                Earth during {firstEra.period}, {firstEra.date}
              </span>
            </figcaption>
          </figure>

          <div class="timeline-meter" aria-hidden="true">
            <span>Birth</span>
            <span class="meter-track">
              <span class="meter-ticks">
                {
                  TIMELINE.map((era) => (
                    <span
                      class="meter-tick"
                      style={`--event-position: ${era.scroll}`}
                    />
                  ))
                }
              </span>
              <span class="meter-fill"></span>
              <span class="meter-cursor"></span>
            </span>
            <span>End</span>
          </div>
        </div>
      </div>

      <div class="scroll-track" aria-hidden="true"></div>

      <ol class="timeline-fallback" aria-label="Earth's eras in chronological order">
        {
          TIMELINE.map((era) => (
            <li data-era-stop={era.id}>
              <p>{era.date}</p>
              <h2>{era.title}</h2>
              <p>{era.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="conclusion" aria-labelledby="conclusion-title">
      <div class="conclusion-orbit" aria-hidden="true">
        <span class="conclusion-ring"></span>
        <span class="conclusion-ring conclusion-ring-middle"></span>
        <span class="conclusion-ring conclusion-ring-inner"></span>
      </div>
      <div class="conclusion-content">
        <p class="conclusion-kicker">After 12.54 billion years</p>
        <h2 class="conclusion-title" id="conclusion-title">
          Endings are
          <em>transformations.</em>
        </h2>
        <p class="conclusion-copy">
          Earth is temporary, but not insignificant. Oceans, ice, forests,
          extinctions and fire each made the world that followed. For one brief
          interval, the planet could look back at its own story.
        </p>
        <a class="return-link" href="#page-top">
          <span>Return to the beginning</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </section>
  </main>

  <script>
    import { initTimeline } from "../scripts/main";

    initTimeline();
  </script>
</Layout>
